{
  "name": "solid-codemirror",
  "version": "2.3.3",
  "description": "CodeMirror component for SolidJS",
  "type": "module",
  "source": "src/index.tsx",
  "types": "dist/index.d.ts",
  "private": false,
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riccardoperra/solid-codemirror.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "cd dev && vite dev",
    "lint": "eslint .",
    "publint": "pn dlx publint",
    "changeset": "changeset",
    "version-packages": "changeset version && pn i",
    "build-test": "pn build && pnpm test && pn typecheck --filter=!./playgrounds/*",
    "release": "changeset publish",
    "ci:publish": "changeset publish",
    "ci:version": "changeset version"
  },
  "keywords": [
    "solidjs",
    "solid-js",
    "codemirror",
    "codemirror6",
    "ide",
    "solid-codemirror",
    "editor",
    "syntax",
    "code"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@typescript-eslint/eslint-plugin": "^5.59.6",
    "@typescript-eslint/parser": "^5.59.6",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-solid": "^0.4.7",
    "jsdom": "^19.0.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "unplugin-solid": "^1.0.0",
    "vite": "^8.0.12",
    "vite-plugin-solid": "^2.11.12"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "solid-js": "^1.7.0"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@codemirror/state": "^6.2.0",
    "@codemirror/view": "^6.12.0",
    "solid-js": "^1.7.5"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*.{js,css,json,md,jsx,yml,yaml}": "prettier --ignore-path .gitignore --write"
  }
}
