{
  "name": "solid-codemirror",
  "version": "3.0.0",
  "description": "CodeMirror component for SolidJS",
  "type": "module",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "private": false,
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riccardoperra/solid-codemirror.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm build && pnpm --filter dev dev",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dev",
    "test": "pnpm build && vitest run",
    "publint": "publint",
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm publint",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "changeset publish",
    "ci:publish": "changeset publish",
    "ci:version": "pnpm version-packages",
    "format": "oxfmt src dev/src tests *.config.ts dev/vite.config.ts"
  },
  "keywords": [
    "solidjs",
    "solid-js",
    "codemirror",
    "codemirror6",
    "ide",
    "solid-codemirror",
    "editor",
    "syntax",
    "code"
  ],
  "devDependencies": {
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.1.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "solid-js": "^2.0.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "solid-js": "^2.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.21.0"
}
